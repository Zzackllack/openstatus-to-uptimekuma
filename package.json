{
  "name": "openstatus-kuma-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Compatibility bridge that makes a self-hosted OpenStatus instance speak Uptime Kuma's internal client protocol",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.4.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:watch": "vitest",
    "test:integration:openstatus": "OPENSTATUS_INTEGRATION_TEST=1 vitest run tests/openstatus-live",
    "bridge": "tsx src/cli.ts",
    "protocol:capture": "tsx scripts/protocol-probe.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.1.1",
    "@node-rs/argon2": "^2.0.2",
    "@openstatus/sdk-node": "0.2.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "node-sqlite3-wasm": "^0.8.51",
    "pino": "^9.13.1",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "pino-pretty": "^13.1.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
