# ---------------------------------------------------------------------------
# openstatus-kuma-bridge configuration
#
# Copy to .env and fill in. Every variable is validated at startup; the bridge
# refuses to start rather than run half-configured. Secrets are never printed
# in validation errors or logs.
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info
# LOG_PROTOCOL=true logs every incoming Kuma event name. Development only.

HOST=0.0.0.0
PORT=3000

# The externally reachable origin, as clients see it. Must be https (http is
# only allowed for localhost). This is what Kuma clients receive as
# `info.primaryBaseURL`, so it must not be an internal address.
PUBLIC_BASE_URL=https://kuma.example.com

# IANA timezone. Affects nothing internal (the bridge works in UTC) but is
# reported to clients, which display times in their own zone anyway.
SERVER_TIMEZONE=Europe/Berlin

# Set to true ONLY when running behind a reverse proxy you control, so client IPs
# (used for login rate limiting) are read from X-Forwarded-For.
TRUST_PROXY=true

# --- OpenStatus (server-side only; never exposed to clients) ---------------
# For self-hosted OpenStatus this is https://<your-openstatus>/rpc
OPENSTATUS_API_URL=https://api.openstatus.dev/rpc
OPENSTATUS_API_KEY=

# --- Bridge authentication -------------------------------------------------
# The iOS client authenticates against the bridge, never against OpenStatus.
BRIDGE_USERNAME=cedric
# Generate with:  pnpm bridge password hash
BRIDGE_PASSWORD_HASH=
# Generate with:  pnpm bridge secret      (must be >= 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Storage ---------------------------------------------------------------
# Holds the OpenStatus<->Kuma id map and the bridge's own check log.
DATABASE_PATH=/app/data/bridge.sqlite

# --- Polling / caching -----------------------------------------------------
STATUS_POLL_INTERVAL_SECONDS=30
MONITOR_LIST_REFRESH_SECONDS=60
SUMMARY_REFRESH_SECONDS=300
# OpenStatus allows 600 requests/minute per API key. Keep concurrency modest.
MAX_OPENSTATUS_CONCURRENCY=5
# After this long without a successful refresh, state is reported as stale and
# /readyz returns 503. /healthz stays 200 on purpose: the bridge is still alive and
# still holding last-known state, so it must not be restarted for this.
STALE_AFTER_SECONDS=300

# How many recent heartbeats to push per monitor on login. Kuma's own frontend
# keeps 150 in memory and the server sends 100; do not exceed 150.
INITIAL_HEARTBEAT_COUNT=100
HEARTBEAT_CACHE_TTL_SECONDS=60

# --- Translation semantics -------------------------------------------------
# What a Kuma status to use for an OpenStatus DEGRADED monitor.
#   pending (default) = Kuma PENDING (2): yellow "not healthy", no outage claim
#   up                = Kuma UP (1): degraded counts toward uptime
#   down              = Kuma DOWN (0): degraded counts as downtime
DEGRADED_STATUS_MAPPING=pending

# How to combine per-region results into one monitor state.
#   openstatus (default) = trust OpenStatus' own quorum-gated monitor.status
#   worst                = any region down -> down
#   majority             = >=50% of regions down -> down (local reimplementation)
#   all / any            = every / at least one region must be up
STATUS_AGGREGATION_STRATEGY=openstatus

# How to combine per-region latency into the single value Kuma expects.
# median (default) is resistant to one geographically distant probe.
LATENCY_AGGREGATION=median

# Where historical heartbeats come from.
#   auto (default)     = OpenStatus response logs for HTTP, bridge observations
#                        for TCP/DNS (OpenStatus exposes no logs for those)
#   openstatus         = only OpenStatus response logs (no history for TCP/DNS)
#   local              = only what the bridge has observed itself
HISTORY_SOURCE=auto
HISTORY_CACHE_TTL_SECONDS=300

# Hard cap on any requested history window, regardless of client request.
MAX_HISTORY_HOURS=720

# --- OpenStatus webhook (real-time push, strongly recommended) -------------
# Without this, state changes reach clients only via polling.
# OpenStatus webhooks carry NO signature/HMAC, so this shared secret header is
# the entire authentication mechanism.
OPENSTATUS_WEBHOOK_SECRET=
OPENSTATUS_WEBHOOK_SECRET_HEADER=X-Bridge-Secret
WEBHOOK_BODY_LIMIT_BYTES=16384

# --- Limits / hardening ----------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
MAX_SOCKET_CONNECTIONS=50
# Comma-separated origins allowed for Socket.IO polling. Native iOS clients send
# no Origin header and are unaffected. Leave empty to match Kuma's own
# production behaviour (rely on the reverse proxy).
ALLOWED_ORIGINS=

METRICS_ENABLED=true